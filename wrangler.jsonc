{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-prog",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "app-prog", "database_id": "bbdc53be-080f-4a24-8ff4-c56f56e6475e" }
  ],
  "observability": { "enabled": true }
}
